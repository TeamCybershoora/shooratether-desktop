{
  "name": "shoora-ai",
  "displayName": "SHOORA AI",
  "description": "Native AI Assistant for SHOORA TETHER by Cybershoora Pvt. Ltd.",
  "version": "1.0.0",
  "publisher": "cybershoora",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shoora-ai-sidebar",
          "title": "SHOORA AI",
          "icon": "resources/shoora-icon.svg"
        }
      ]
    },
    "views": {
      "shoora-ai-sidebar": [
        {
          "type": "webview",
          "id": "shoora.projectStatusView",
          "name": "📊 Project Status"
        },
        {
          "type": "webview",
          "id": "shoora.chatView",
          "name": "🤖 AI Agent"
        },
        {
          "type": "webview",
          "id": "shoora.githubView",
          "name": "🐙 GitHub Control"
        },
        {
          "type": "webview",
          "id": "shoora.cloudView",
          "name": "☁️ Cloud & Deployments"
        }
      ]
    },
    "commands": [
      {
        "command": "shoora.cloud.deploy",
        "title": "SHOORA: Deploy to Cloud (AWS)",
        "category": "SHOORA Cloud"
      },
      {
        "command": "shoora.cloud.rollback",
        "title": "SHOORA: Rollback Cloud Deployment",
        "category": "SHOORA Cloud"
      },
      {
        "command": "shoora.cloud.refresh",
        "title": "SHOORA: Refresh Cloud Status",
        "category": "SHOORA Cloud"
      },
      {
        "command": "shoora.project.refresh",
        "title": "SHOORA: Refresh Project Status",
        "category": "SHOORA Project"
      },
      {
        "command": "shoora.github.createRepo",
        "title": "SHOORA: Create GitHub Repository & Push",
        "category": "SHOORA GitHub"
      },
      {
        "command": "shoora.github.createPR",
        "title": "SHOORA: Create Pull Request",
        "category": "SHOORA GitHub"
      },
      {
        "command": "shoora.github.refresh",
        "title": "SHOORA: Refresh GitHub Status",
        "category": "SHOORA GitHub"
      },
      {
        "command": "shoora.openChat",
        "title": "SHOORA: Open AI Chat",
        "category": "SHOORA AI"
      },
      {
        "command": "shoora.inlineEdit",
        "title": "SHOORA: Inline Edit / Generate Code",
        "category": "SHOORA AI"
      },
      {
        "command": "shoora.explainSelection",
        "title": "SHOORA: Explain Selected Code",
        "category": "SHOORA AI"
      },
      {
        "command": "shoora.fixSelection",
        "title": "SHOORA: Fix Code / Bugs",
        "category": "SHOORA AI"
      },
      {
        "command": "shoora.runAgentTask",
        "title": "SHOORA: Run Agent Task",
        "category": "SHOORA AI"
      },
      {
        "command": "shoora.cancelTask",
        "title": "SHOORA: Cancel Running Task",
        "category": "SHOORA AI"
      },
      {
        "command": "shoora.clearChat",
        "title": "SHOORA: Clear Conversation",
        "category": "SHOORA AI"
      }
    ],
    "keybindings": [
      {
        "command": "shoora.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      },
      {
        "command": "shoora.openChat",
        "key": "ctrl+l",
        "mac": "cmd+l"
      }
    ],
    "configuration": {
      "title": "SHOORA AI",
      "properties": {
        "shoora.provider": {
          "type": "string",
          "default": "gemini",
          "enum": ["gemini", "openai", "claude", "ollama"],
          "description": "Select the AI Provider"
        },
        "shoora.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for selected provider (Google Gemini, OpenAI, or Anthropic)"
        },
        "shoora.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local Ollama server URL"
        },
        "shoora.model": {
          "type": "string",
          "default": "gemini-1.5-flash",
          "description": "Model identifier"
        },
        "shoora.security.autoApproveSensitive": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve sensitive operations (file writes, edits) without asking each time. Critical operations always require approval."
        }
      }
    }
  }
}
